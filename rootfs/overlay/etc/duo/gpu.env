# GPU Adreno 640 via Turnip (KGSL) — recette Matrix
export MESA_LOADER_DRIVER_OVERRIDE=zink
export TU_DEBUG=sysmem,nolrz,noubwc
# vulkan (comme Matrix) : plus de déchirement en dents de scie pendant les animations (gles2/zink en avait)
export WLR_RENDERER=${DUO_WLR_RENDERER:-vulkan}
export WLR_DRM_NO_MODIFIERS=1 WLR_NO_HARDWARE_CURSORS=1
export GSK_RENDERER=${DUO_GSK:-ngl}
unset GDK_DISABLE
# noyau 4.14 sans faccessat2 : shim pour AppStream/GLib (sinon Phosh plante au rafraîchissement du catalogue)
[ -f /usr/local/lib/libduo-faccessat2.so ] && export LD_PRELOAD=/usr/local/lib/libduo-faccessat2.so
# langue de la session (traductions *-lang, musl-locales) : français, heure de Paris
export LANG=fr_FR.UTF-8 LANGUAGE=fr_FR:fr LC_ALL= TZ=Europe/Paris MUSL_LOCPATH=/usr/share/i18n/locales/musl   # musl-locales : dates en français
