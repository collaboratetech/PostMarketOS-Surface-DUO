# Session tactile Surface Duo (sway, rendu logiciel)
set $mod Mod4
output * bg #14202c solid_color
output * scale 2
output Virtual-1 disable
output DSI-1 position 0 0
output DSI-2 position 675 0
input "1118:3073:Surface_Duo_Touch_A" map_to_output DSI-1
input "1118:3074:Surface_Duo_Touch_B" map_to_output DSI-2
default_border pixel 3
titlebar_padding 6 4
font pango:DejaVu Sans 9
seat * hide_cursor 1000
workspace 1 output DSI-1
workspace 2 output DSI-2
bar {
  position top
  height 40
  font pango:DejaVu Sans Bold 12
  status_command /usr/local/bin/duo-status
  colors {
    background #0b1118
    statusline #e8eef4
  }
}
exec wvkbd-mobintl --hidden -L 300 -H 280
exec /usr/local/bin/duo-gestes
exec foot
