#!/bin/sh
# Wi-Fi du Surface Duo sous noyau 4.14 (méthode Matrix) — lancé HORS chroot, binaires et firmwares dans /r
# Le modem héberge le firmware Wi-Fi. rmtfs en LECTURE SEULE (-r) : rien n'est écrit sur modemst1/2, fsg, fsc.
R=/r; C="chroot $R"
log() { echo "duo-wifi: $*" | tee -a /tmp/duo-wifi.log > /dev/kmsg; }
# firmwares modem/Wi-Fi dans le /lib/firmware du noyau (le chemin personnalisé n'est pas pris par le chargeur PIL)
for f in $R/lib/firmware/modem.* $R/lib/firmware/wlanmdsp.mbn $R/lib/firmware/bdwlan* $R/lib/firmware/*.jsn $R/lib/firmware/ipa_fws.*; do [ -e /lib/firmware/${f##*/} ] || cp -a $f /lib/firmware/; done
mkdir -p /lib/firmware/wlan/qca_cld; cp -n $R/lib/firmware/wlan/qca_cld/* /lib/firmware/wlan/qca_cld/
# rmtfs attend /dev/qcom_rmtfs_uio1 (règle udev Matrix : uio nommé « rmtfs »)
for u in /sys/class/uio/uio*; do [ "$(cat $u/name)" = rmtfs ] && ln -sf /dev/${u##*/} /dev/qcom_rmtfs_uio1; done
for p in qrtr-ns pd-mapper rmtfs tqftpserv wlfwd; do pidof $p >/dev/null && continue
  case $p in
    qrtr-ns)   setsid $C /usr/bin/qrtr-ns -f > /tmp/qrtr-ns.log 2>&1 & ;;
    pd-mapper) setsid $C /usr/bin/pd-mapper > /tmp/pd-mapper.log 2>&1 & ;;
    rmtfs)     for i in $(seq 40); do [ -e /dev/qcom_rmtfs_uio1 ] && break; sleep 0.5; done
               setsid $C /usr/bin/rmtfs -r -P -v > /tmp/rmtfs.log 2>&1 & ;;
    tqftpserv) setsid $C /usr/bin/tqftpserv > /tmp/tqftpserv.log 2>&1 & ;;
    wlfwd)     ;;  # après le modem
  esac; sleep 1
done
log "services : qrtr-ns=$(pidof qrtr-ns) pd-mapper=$(pidof pd-mapper) rmtfs=$(pidof rmtfs) tqftpserv=$(pidof tqftpserv)"
# modem : niveau de redémarrage RELATED, puis on garde /dev/subsys_modem ouvert (le fermer arrête le modem)
for s in /sys/bus/msm_subsys/devices/subsys*; do case "$(cat $s/name)" in modem) M=$s; echo RELATED > $s/restart_level;; esac; done
setsid sh -c 'exec 3</dev/subsys_modem; exec sleep 2147483647' &
for i in $(seq 30); do grep -q ONLINE $M/state 2>/dev/null && break; sleep 1; done
log "modem : $(cat $M/state)"
mkdir -p $R/var/lib/wlfwd
pidof wlfwd >/dev/null || setsid $C /usr/local/bin/wlfwd /lib/firmware 02:4d:53:44:55:4f /var/lib/wlfwd > /tmp/wlfwd.log 2>&1 &
grep -q ^wlan /proc/modules || insmod $R/lib/modules/wlan.ko
for i in $(seq 60); do [ -e /dev/wlan ] && break; sleep 1; done
for i in $(seq 30); do grep -q "FW READY" /sys/kernel/debug/icnss/stats 2>/dev/null && break; sleep 1; done
(echo ON > /dev/wlan) 2>/dev/null
for i in $(seq 60); do [ -d /sys/class/net/wlan0 ] && break; sleep 1; done
log "résultat : $(ls /sys/class/net | tr '\n' ' ')"
# cellulaire : firmware IPA (port de données rmnet_ipa0), puis ModemManager (SIM, SMS, appels)
(echo 1 > /dev/ipa) 2>/dev/null
for i in $(seq 30); do [ -d /sys/class/net/rmnet_ipa0 ] && break; sleep 1; done
for i in $(seq 60); do [ -S $R/run/dbus/system_bus_socket ] && break; sleep 1; done
$C udevadm trigger --action=add /sys/class/net/rmnet_ipa0 2>/dev/null; sleep 1
pidof ModemManager >/dev/null || setsid $C /usr/sbin/ModemManager > /tmp/mm.log 2>&1 < /dev/null &
sleep 2; log "cellulaire : $(ls /sys/class/net | grep rmnet_ipa) ModemManager=$(pidof ModemManager)"
# audio d'appel automatique (relie le flux voix du modem au haut-parleur et au micro pendant un appel)
pidof -x duo-appel-veille >/dev/null || setsid $C /usr/local/sbin/duo-appel-veille > /tmp/appel.log 2>&1 < /dev/null &
pidof -x duo-donnees >/dev/null || setsid $C /usr/local/sbin/duo-donnees > /dev/null 2>&1 < /dev/null &   # données mobiles 4G (chemin IPA fait main)
# heure : le Duo démarre au 1er janvier 1970 (sans heure, Firefox refuse tous les sites https) ->
# synchro réseau (ntpd de busybox) dès que le Wi-Fi répond, nouvel essai toutes les 20 s jusqu'à réussite
(for i in $(seq 90); do $C busybox ntpd -n -q -p pool.ntp.org -p time.cloudflare.com > /dev/null 2>&1 && { log "heure : $(date)"; break; }; sleep 20; done) &
