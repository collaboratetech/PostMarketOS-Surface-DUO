#!/bin/sh
# Capteurs (lancé HORS chroot) : DSP capteurs SLPI, hexagonrpcd (registre/config en LECTURE pour le DSP), puis duo-posture.
# Rien n'est écrit sur le téléphone : le registre est une copie locale dans /usr/share/duo/hexagon.
R=/r; C="chroot $R"; H=$R/usr/share/duo/hexagon
for f in hw_platform platform_subtype platform_subtype_id platform_version soc_id revision; do
  [ -r /sys/devices/soc0/$f ] && cat /sys/devices/soc0/$f > $H/socinfo/$f; done
for f in $R/lib/firmware/slpi*; do [ -e /lib/firmware/${f##*/} ] || cp -a $f /lib/firmware/; done
echo 1 > /sys/kernel/boot_slpi/boot 2>/dev/null
for i in $(seq 30); do for d in /sys/bus/msm_subsys/devices/subsys*; do [ "$(cat $d/name)" = slpi ] && S=$(cat $d/state); done; [ "$S" = ONLINE ] && break; sleep 1; done
echo "duo-capteurs: slpi=$S" > /dev/kmsg
# hexagonrpcd relancé s'il s'arrête (le DSP le rappelle pour son registre, après une veille par exemple)
pidof hexagonrpcd >/dev/null || (while :; do $C /usr/local/bin/hexagonrpcd -f /dev/adsprpc-smd-secure -s -R /usr/share/duo/hexagon >> /tmp/hexagonrpcd.log 2>&1 < /dev/null; sleep 60; done) &
sleep 5
# posture : attend la session Phosh (luminosité, mise en veille via Mutter DisplayConfig)
for i in $(seq 120); do pidof phosh >/dev/null && break; sleep 1; done
pgrep -f duo-posture >/dev/null || setsid $C /usr/local/sbin/duo-posture > /tmp/posture.log 2>&1 < /dev/null &
# capteur de lumière publié comme iio-sensor-proxy (luminosité automatique de Phosh) ; attend le bus système
for i in $(seq 60); do [ -S $R/run/dbus/system_bus_socket ] && break; sleep 1; done
pgrep -f duo-sensorproxy >/dev/null || setsid $C /usr/local/sbin/duo-sensorproxy > /tmp/sensorproxy.log 2>&1 < /dev/null &
# veille profonde : service de mise en veille (désactivé tant que /root/.config/duo/veille ne contient pas « on »)
pgrep -f duo-veille >/dev/null || setsid $C /usr/local/sbin/duo-veille > /tmp/veille.log 2>&1 < /dev/null &
# CPU : états basse consommation (le noyau Microsoft les interdit au démarrage, Android les rouvre ; ~ -20 mA)
(sleep 60; echo N > /sys/module/lpm_levels/parameters/sleep_disabled) &
