#!/bin/busybox sh
# Test 4.14 en RAM : rien n'est monté depuis le stockage. Gadget USB NCM + telnet 172.16.42.1.
/bin/busybox --install -s
mount -t devtmpfs dev /dev || mdev -s; mount -t proc proc /proc; mount -t sysfs sys /sys
mkdir -p /dev/pts /tmp /dev/shm; mount -t tmpfs -o mode=1777 shm /dev/shm; mount -t devpts devpts /dev/pts; mount -t configfs configfs /sys/kernel/config
mount -t debugfs none /sys/kernel/debug 2>/dev/null
echo "duo414: init (noyau $(uname -r))" > /dev/kmsg
G=/sys/kernel/config/usb_gadget/duo; mkdir -p $G; cd $G
echo 0x1d6b > idVendor; echo 0x0104 > idProduct
mkdir -p strings/0x409; echo "Surface Duo 4.14 test" > strings/0x409/product; echo DuoPort > strings/0x409/manufacturer; echo duo414 > strings/0x409/serialnumber
mkdir -p configs/c.1/strings/0x409; echo NCM > configs/c.1/strings/0x409/configuration
mkdir -p functions/ncm.usb0 functions/acm.GS0; ln -sf $G/functions/ncm.usb0 configs/c.1/; ln -sf $G/functions/acm.GS0 configs/c.1/
cd /; for i in $(seq 60); do U=$(ls /sys/class/udc 2>/dev/null | head -1); [ -n "$U" ] && break; sleep 1; done
echo "$U" > $G/UDC
sleep 2; N=$(cat $G/functions/ncm.usb0/ifname 2>/dev/null); [ -n "$N" ] && [ -e /sys/class/net/$N ] || N=$(ls /sys/class/net | grep -vE '^(lo|dummy|sit|ip6|bond|rmnet|r_rmnet|wlan|p2p|tun)' | head -1)
echo "duo414: interfaces $(ls /sys/class/net | tr '
' ' ') -> $N" > /dev/kmsg
ip addr add 172.16.42.1/24 dev ${N:-usb0}; ip link set ${N:-usb0} up
ip addr add 169.254.42.1/16 dev ${N:-usb0}
/bin/bindsh 2323 &
# gardien du lien USB : le gadget du Duo décroche parfois ; si le PC ne répond plus 3 fois de suite
# alors qu'il répondait, on « rebranche » le port (sans effet si aucun PC n'est branché)
(vu=0; echecs=0; while true; do sleep 5
   if ping -c1 -W2 172.16.42.2 >/dev/null 2>&1; then vu=1; echecs=0; continue; fi
   [ $vu = 1 ] || continue
   echecs=$((echecs+1)); [ $echecs -lt 3 ] && continue
   echo "duo414: lien USB perdu -> rebranchement" > /dev/kmsg
   echo "" > $G/UDC; sleep 2; echo "$U" > $G/UDC; sleep 3
   ip addr add 172.16.42.1/24 dev ${N:-usb0} 2>/dev/null; ip link set ${N:-usb0} up; echecs=0; vu=0
 done) &
busybox-extras telnetd -l /bin/sh > /tmp/telnetd.log 2>&1 || telnetd -l /bin/sh
(unudhcpd -i ${N:-usb0} -s 172.16.42.1 -c 172.16.42.2 > /tmp/dhcp.log 2>&1 &)
# shell sur le port s�rie USB (COM sous Windows)
(while true; do [ -e /dev/ttyGS0 ] && setsid sh -c "exec sh -i </dev/ttyGS0 >/dev/ttyGS0 2>&1"; sleep 1; done) &
echo "duo414: telnet pret sur ${N:-?} (UDC $U)" > /dev/kmsg
# mire sur les deux écrans dès que DRM est là
# diagnostic lisible depuis Windows : on republie le gadget avec l'etat dans le nom du produit
diag() {
  D="N=$N op=$(cat /sys/class/net/$N/operstate 2>/dev/null) ip=$(ip -4 addr show $N 2>/dev/null | grep -c inet) tel=$(pidof telnetd) ifs=$(ls /sys/class/net | tr '\n' ,) dri=$(ls /dev/dri 2>/dev/null | tr '\n' ,) fb=$(ls /dev | grep -c '^fb') $(head -c 60 /tmp/drmfill.log 2>/dev/null | tr '\n' ' ')"
  echo "duo414 diag: $D" > /dev/kmsg
  echo "" > $G/UDC; sleep 1
  echo "$D" | cut -c1-120 > $G/strings/0x409/product
  echo "$U" > $G/UDC
}
for i in $(seq 20); do [ -e /sys/class/drm/card0 ] && break; sleep 1; done
mdev -s 2>/dev/null
mkdir -p /dev/dri; for c in /sys/class/drm/card*; do n=$(basename $c); [ -f $c/dev ] || continue; [ -e /dev/dri/$n ] || mknod /dev/dri/$n c $(cut -d: -f1 $c/dev) $(cut -d: -f2 $c/dev); done
for i in $(seq 20); do [ -e /dev/dri/card0 ] && break; sleep 1; done
/bin/drmfill 600 0 > /tmp/drmfill.log 2>&1 &
# (diag désactivé : le rebranchement USB gêne usbipd)
# retour automatique sous Android au bout de 10 min sauf si /tmp/rester existe
(sleep 600; [ -f /tmp/rester ] || echo b > /proc/sysrq-trigger) &
while true; do sleep 3600; done
