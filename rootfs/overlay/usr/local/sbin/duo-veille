#!/usr/bin/python3 -I
"""duo-veille : vraie mise en veille (suspend-to-RAM) du Surface Duo sous Phosh, d'après duo-schlaf de Matrix.

Écrans éteints (bouton Power ou Duo fermé) depuis DELAI secondes, et rien qui l'empêche -> on prépare et on suspend :
  1. repos des capteurs continus (/run/duo/repos : duo-posture coupe l'accéléromètre, duo-sensorproxy la lumière ;
     la posture reste active : elle ne parle qu'au changement de position -> peut réveiller à l'ouverture)
  2. arrêt de duo-bt (l'UART Bluetooth ouvert fait échouer la veille, -EBUSY)
  3. veille par elogind (loginctl suspend : NetworkManager endort le Wi-Fi proprement ; un « echo mem » nu échoue)
  3b. son et USB mis en pause juste avant : la sortie audio que PipeWire garde ouverte fait ~100 interruptions/s
     de l'ADSP (glink) qui réveillent aussitôt ; le contrôleur USB (dwc3) branché garde un verrou d'éveil -> mode
     « none » (la charge continue, elle ne passe pas par dwc3). Marche donc aussi câble branché (chargeur ou PC).
  4. au réveil : USB et son rallumés, fin du repos, duo-bt relancé ; duo-power rallume les écrans au bouton Power.
Jamais : son en cours, appel en cours.
Réglage /root/.config/duo/veille : « on » (par défaut depuis le 12/11, testée câble branché) ou « off »,
/root/.config/duo/veille-delai : secondes (60 par défaut). Journal : /var/log/duo-veille.log."""
import os, re, subprocess, time

REPOS = "/run/duo/repos"
REGLAGE = "/root/.config/duo/veille"
DELAI = "/root/.config/duo/veille-delai"
JOURNAL = "/var/log/duo-veille.log"
STATS = "/sys/kernel/debug/suspend_stats"


def log(m):
    print("duo-veille: " + m, flush=True)
    try:
        with open(JOURNAL, "a") as f:
            f.write(time.strftime("%d/%m %H:%M:%S ") + m + "\n")
    except OSError:
        pass


def lire(p, d=""):
    try:
        with open(p) as f:
            return f.read().strip()
    except OSError:
        return d


def lancer(*cmd, timeout=15):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def actif():
    return lire(REGLAGE, "off").lower() in ("on", "1", "oui")


def delai():
    try:
        return max(20, int(lire(DELAI, "60")))
    except ValueError:
        return 60


def ecrans_eteints():
    # les DEUX écrans : plié, l'écran de dos est coupé alors que celui de face sert (bug du 12/11 : veille en pleine
    # utilisation, écran qui « fait du bruit » au réveil)
    return all(lire("/sys/class/drm/card0-%s/enabled" % o) == "disabled" for o in ("DSI-1", "DSI-2"))


def compteurs():
    t = lire(STATS)
    g = lambda k: int(m.group(1)) if (m := re.search(r"^%s:\s*(\d+)" % k, t, re.M)) else -1
    return g("success"), g("fail")


USB_MODE = "/sys/devices/platform/soc/a600000.ssusb/mode"
ENV_SON = dict(os.environ, XDG_RUNTIME_DIR="/run/user/0")


def ecrire(p, v):
    try:
        with open(p, "w") as f:
            f.write(v)
        return True
    except OSError:
        return False


def son(marche):
    """pause/reprise de la sortie et du micro PipeWire (sinon l'ADSP réveille le Duo en continu)"""
    v = "0" if marche else "1"
    for cmd in (["pactl", "suspend-sink", "@DEFAULT_SINK@", v], ["pactl", "suspend-source", "@DEFAULT_SOURCE@", v]):
        try:
            subprocess.run(cmd, env=ENV_SON, capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass
    if marche:   # le volume n'est pris en compte qu'après un premier son : on rejoue le silence (comme au démarrage)
        try:
            subprocess.Popen(["pw-play", "/usr/share/duo/silence.wav"], env=ENV_SON, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
        except OSError:
            pass


def usb_couper():
    """câble branché : contrôleur USB en mode « none » le temps de la veille ; rend le mode d'avant (ou None)"""
    if lire("/sys/class/power_supply/usb/online", "0") != "1":
        return None
    avant = lire(USB_MODE)
    if not avant or avant == "none" or not ecrire(USB_MODE, "none"):
        return None
    time.sleep(2)
    return avant


def prochaine_alarme():
    """heure (epoch) de la prochaine alarme de GNOME Horloges (réglage org.gnome.clocks alarms), ou None"""
    import datetime
    bus = None
    for pid in os.listdir("/proc"):
        try:
            if pid.isdigit() and open("/proc/%s/comm" % pid).read().strip() == "phosh":
                for kv in open("/proc/%s/environ" % pid, "rb").read().split(b"\0"):
                    if kv.startswith(b"DBUS_SESSION_BUS_ADDRESS="):
                        bus = kv.split(b"=", 1)[1].decode()
                break
        except OSError:
            continue
    try:
        t = subprocess.run(["gsettings", "get", "org.gnome.clocks", "alarms"], capture_output=True, text=True, timeout=5,
                           env=dict(ENV_SON, HOME="/root", DBUS_SESSION_BUS_ADDRESS=bus or "")).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    maintenant = datetime.datetime.now()
    meilleures = []
    for bloc in re.findall(r"\{(.*?)\}", t, re.S):
        # alarme déjà programmée par Horloges (sonnerie ou répétition) : on la prend telle quelle
        for cle in ("snooze-time", "ring-time"):
            m = re.search(r"'%s': <'([^']+)'>" % cle, bloc)
            if m:
                try:
                    d = datetime.datetime.fromisoformat(m.group(1).replace("Z", "+00:00"))
                    meilleures.append(d.timestamp())
                except ValueError:
                    pass
        h = re.search(r"'hour': <(\d+)>", bloc); mi = re.search(r"'minute': <(\d+)>", bloc)
        if not (h and mi):
            continue
        mj = re.search(r"'days': <(?:@ai )?\[([^\]]*)\]>", bloc)
        jours = [int(x) for x in re.findall(r"\d+", mj.group(1))] if mj else []   # 1 = lundi … 7 = dimanche
        for k in range(8):
            c = (maintenant + datetime.timedelta(days=k)).replace(hour=int(h.group(1)), minute=int(mi.group(1)),
                                                                   second=0, microsecond=0)
            if c <= maintenant:
                continue
            if jours and c.isoweekday() not in jours:
                continue
            meilleures.append(c.timestamp())
            break
    futures = [x for x in meilleures if x > time.time()]
    return min(futures) if futures else None


def reveil_alarme():
    """programme le réveil matériel (RTC) 20 s avant la prochaine alarme ; renvoie le texte pour le journal"""
    a = prochaine_alarme()
    ecrire("/sys/class/rtc/rtc0/wakealarm", "0")
    if a is None:
        return ""
    ecrire("/sys/class/rtc/rtc0/wakealarm", str(int(a) - 20))
    return ", réveil programmé pour l'alarme de " + time.strftime("%H:%M", time.localtime(a))


def obstacle():
    env = ENV_SON
    try:
        flux = subprocess.run(["pactl", "list", "short", "sink-inputs"], capture_output=True, text=True,
                              timeout=5, env=env).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        flux = ""
    if flux:
        return "son en cours"
    if re.search(r"\((dialing|ringing-out|ringing-in|active|held)\)", lancer("mmcli", "-m", "any", "--voice-list-calls")):
        return "appel en cours"
    return None


def capteurs_au_repos(limite=10.0):
    """attend que seuls les flux « posture » restent (accéléromètre et lumière coupés)"""
    fin = time.monotonic() + limite
    while time.monotonic() < fin:
        ps = lancer("ps", "-o", "args")
        if not re.search(r"ssccli --sensor (accelerometer|light|hinge_angle)", ps):
            return True
        time.sleep(0.5)
    return False


def bt(demarrer):
    if demarrer:
        if not lancer("pidof", "duo-bt").strip():
            subprocess.Popen(["setsid", "/usr/local/sbin/duo-bt"], stdout=open("/tmp/duo-bt.log", "a"),
                             stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    else:
        lancer("killall", "duo-bt")


def reprendre():
    try:
        os.unlink(REPOS)
    except FileNotFoundError:
        pass
    bt(True)


def dormir():
    os.makedirs("/run/duo", exist_ok=True)
    open(REPOS, "w").close()
    bt(False)
    if not capteurs_au_repos():
        log("capteurs pas au repos -> pas de veille")
        reprendre()
        return "sautee"
    time.sleep(2)
    if not ecrans_eteints() or obstacle():
        reprendre()                     # l'utilisateur est revenu entre-temps
        return "sautee"
    cable = lire("/sys/class/power_supply/usb/real_type") if lire("/sys/class/power_supply/usb/online", "0") == "1" else ""
    alarme = reveil_alarme()
    if alarme:
        log("veille" + alarme)
    son(False)
    usb_avant = usb_couper()
    s0, f0 = compteurs()
    mur0, mono0 = time.time(), time.monotonic()
    os.sync()
    try:
        lancer("loginctl", "suspend")
        fin = time.monotonic() + 90     # loginctl rend la main tout de suite : on attend que le noyau compte l'essai
        while time.monotonic() < fin and compteurs() == (s0, f0):
            time.sleep(0.5)
    finally:
        if usb_avant:
            ecrire(USB_MODE, usb_avant)
        son(True)
    s1, f1 = compteurs()
    reprendre()
    dormi = s1 > s0
    duree = time.time() - mur0 - (time.monotonic() - mono0)   # l'horloge murale avance pendant la veille, pas la monotone
    noyau = lancer("dmesg").splitlines()
    debut = max((i for i, l in enumerate(noyau) if "PM: suspend entry" in l), default=len(noyau))
    cause = " | ".join(l.split("]", 1)[-1].strip() for l in noyau[max(0, debut - 3):]
                       if "Resume caused" in l or "last active wakeup" in l or "failed to suspend" in l)[:300]
    log("%s, %.0f s de veille, batterie %s %%%s (%s)" % ("réveil" if dormi else "veille avortée", duree,
        lire("/sys/class/power_supply/battery/capacity", "?"), ", câble " + cable if cable else "", cause or "cause inconnue"))
    return "dormi" if dormi else "avortee"


def main():
    if os.path.exists(REPOS):
        reprendre()
    log("prêt (%s, délai %d s)" % ("activée" if actif() else "désactivée", delai()))
    noir_depuis, reessai, ratés, dernier = None, 0.0, 0, None
    while True:
        time.sleep(5)
        now = time.monotonic()
        if not ecrans_eteints() or not actif():
            noir_depuis, ratés, dernier = None, 0, None
            continue
        if noir_depuis is None:
            noir_depuis = now
        if now - noir_depuis < delai() or now < reessai:
            continue
        pourquoi = obstacle()
        if pourquoi:
            if pourquoi != dernier:
                log("écrans éteints mais pas de veille : " + pourquoi)
                dernier = pourquoi
            continue
        dernier = None
        r = dormir()
        time.sleep(4)                   # laisse duo-power traiter l'appui de réveil
        if not ecrans_eteints():
            noir_depuis, ratés = None, 0   # réveillé par l'utilisateur
            continue
        ratés += 1                      # réveillé par autre chose (ou avortée) : on recommence plus tard
        reessai = time.monotonic() + (30 if r == "sautee" else 15 if ratés < 4 else min(600, 60 * ratés))


if __name__ == "__main__":
    main()
